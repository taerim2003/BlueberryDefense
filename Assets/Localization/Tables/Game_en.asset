    m_Metadata:
      m_Items: []
  - m_Id: 709095006230
    m_Localized: Rewind
    m_Metadata:
      m_Items: []
  - m_Id: 709095006231
    m_Localized: Pulls every other skill's cooldown forward by 1 second. Rewinds
      further with each level
    m_Metadata:
      m_Items: []
  - m_Id: 709095006238
