    m_Metadata:
      m_Items: []
  - m_Id: 709090812046
    m_Localized: Homing Missile
    m_Metadata:
      m_Items: []
  - m_Id: 709090812047
    m_Localized: Fires 3 missiles that chase enemies. Each level adds many more,
      and it grows stronger the more you use it (this run only)
    m_Metadata:
      m_Items: []
  - m_Id: 709090812054
    m_Localized: The rounds get lighter
    m_Metadata:
      m_Items: []
  - m_Id: 709090812056
    m_Localized: You would not dare to count
    m_Metadata:
      m_Items: []
