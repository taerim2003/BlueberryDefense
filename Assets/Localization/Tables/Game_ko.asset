      m_Items: []
  - m_Id: 269044864983080
    m_Localized: "\uB099\uB8B0\uAC00 \uCE60 \uB54C\uB9C8\uB2E4 \uB099\uB8B0 \uCFE8\uD0C0\uC784
      -0.01\uCD08"
