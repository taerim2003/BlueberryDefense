      m_Items: []
  - m_Id: 709082423296
    m_Localized: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uD654\uC0B4\uC744
      \uC3DC\uB2E4. \uB808\uBCA8\uC5C5\uC73C\uB85C \uD654\uC0B4 \uC218\uC640 \uAD00\uD1B5\uC774
