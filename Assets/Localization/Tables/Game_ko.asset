    m_Localized: "\uD654\uC0B4\uBE44 +{0}\uCC28\uB840"
    m_Metadata:
      m_Items: []
  - m_Id: 4598347408809984
    m_Localized: "{0}\uD68C \uB0A8\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 4675683734986752
    m_Localized: "\uB9F5"
    m_Metadata:
      m_Items: []
  - m_Id: 4677687156875264
    m_Localized: "\uC7A0\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 4693959512891392
    m_Localized: "\uB2E4\uC2DC\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4693959529668608
    m_Localized: "\uC5C5\uADF8\uB808\uC774\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 7524159980249088
    m_Localized: "\uB3C5\uC131 \uD3EC\uB3C4\uC54C"
    m_Metadata:
      m_Items: []
  - m_Id: 7524160026386432
    m_Localized: "\uB3C5\uC131 \uD3EC\uB3C4\uC54C\uC744 \uB358\uC9C4\uB2E4. \uD130\uC9C4
      \uC790\uB9AC\uC5D0 \uB3C5\uC548\uAC1C\uAC00 \uAE54\uB824 \uC801\uC744 \uC911\uB3C5\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7524160026386433
    m_Localized: "\uC0DD\uD654\uD559 \uD3EC\uB3C4\uC54C"
    m_Metadata:
      m_Items: []
  - m_Id: 7524160026386434
    m_Localized: "\uC7AC\uC559\uC758 \uC5ED\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 7524160026386435
    m_Localized: "\uCC0C\uB9BF\uCC0C\uB9BF \uD3EC\uB3C4\uC54C"
    m_Metadata:
      m_Items: []
  - m_Id: 7524160026386436
    m_Localized: "\uBA54\uB450\uC0AC\uC758 \uAC04\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 7524160026386438
    m_Localized: "\uD55C \uBC88\uC5D0 \uB354 \uB9CE\uC740 \uD3EC\uB3C4\uC54C\uC744
      \uB358\uC9C0\uACE0, \uC548\uAC1C\uC5D0 \uB4E4\uC5B4\uC628 \uC801\uC740 \uC9E7\uAC8C
      \uAE30\uC808\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7524160026386440
    m_Localized: "\uC911\uB3C5 \uC0C1\uD0DC\uC758 \uC801\uC740 \uC8FC\uAE30\uC801\uC73C\uB85C
      \uAE30\uC808\uD558\uACE0, \uBC1B\uB294 \uD53C\uD574\uAC00 \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9432851369631744
    m_Localized: "\uC9C4\uD654 \uC870\uAC74 \u2014 Lv.{0} \xB7 \uC5F0\uACC4: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 9432851445129216
    m_Localized: "\uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 9432851445129217
    m_Localized: ???
    m_Metadata:
      m_Items: []
  - m_Id: 9432851445129218
    m_Localized: "[\uC7A0\uAE40 \u2014 \uC2A4\uD0AC\uD2B8\uB9AC\uC5D0\uC11C \uAC1C\uBC29]"
    m_Metadata:
      m_Items: []
  - m_Id: 9649661696221184
    m_Localized: "\uD06C\uACE0 \uB0A0\uCE74\uB85C\uC6B4 \uD654\uC0B4 \uD55C \uBC1C\uB85C
      \uC801\uB4E4\uC744 \uAFF0\uB6AB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998400
    m_Localized: "\uC218\uB9CE\uC740 \uCD94\uACA9 \uD654\uC0B4\uC774 \uCEE4\uB2E4\uB780
      \uD654\uC0B4 \uACC1\uC5D0 \uB530\uB77C\uBD99\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998401
    m_Localized: "\uD558\uB098\uC758 \uAC70\uB300\uD55C \uC18C\uC6A9\uB3CC\uC774\uB97C
      \uC18C\uD658\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998402
    m_Localized: "\uD68C\uC624\uB9AC\uC5D0 \uB9DE\uC740 \uC801\uB4E4\uC774 \uB2E4\uB978
      \uACF5\uACA9\uC5D0 \uCDE8\uC57D\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998403
    m_Localized: "\uB9C8\uB825 \uC624\uBE0C\uAC00 \uB354\uC6B1 \uCEE4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998404
    m_Localized: "\uBAA8\uB4E0 \uAC83\uC744 \uAD00\uD1B5\uD558\uB294 \uCD08\uB300\uD615
      \uC624\uBE0C\uB97C \uC18C\uD658\uD574 \uC8FC\uC704 \uC801\uB4E4\uC744 \uB04C\uC5B4\uB2F9\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998405
    m_Localized: "\uB3C5\uC218\uB9AC\uAC00 \uB5A8\uC5B4\uC9C4 \uACF3\uC5D0 \uD3ED\uBC1C\uC774
      \uC0DD\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998406
    m_Localized: "\uAC70\uB300\uD55C \uB2E4\uC774\uB108\uB9C8\uC774\uD2B8 \uB3C5\uC218\uB9AC
      \uD55C \uB9C8\uB9AC\uAC00 \uB5A8\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998407
    m_Localized: "\uCD1D\uC54C\uC774 \uAF42\uD78C \uC790\uB9AC\uC5D0 \uB3C5\uC218\uB9AC\uAC00
      \uB5A8\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998408
    m_Localized: "\uAC00\uC7A5 \uAC15\uB825\uD55C \uC801\uC744 \uC870\uC900\uD574
      \uB3C5\uC218\uB9AC \uD2B9\uACF5\uB300\uC5D0\uAC8C \uC9C0\uC2DC\uB97C \uB0B4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998409
    m_Localized: "\uBBF8\uC0AC\uC77C\uC774 \uB2FF\uB294 \uACF3\uC5D0 \uC791\uC740
      \uD3ED\uBC1C\uC774 \uC0DD\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998410
    m_Localized: "\uAC00\uC7A5 \uAC15\uD55C \uC801\uC5D0\uAC8C \uAC70\uB300\uD55C
      \uB85C\uCF13 \uD558\uB098\uB97C \uB0A0\uB824\uC11C \uC5C4\uCCAD\uB09C \uD3ED\uBC1C\uC744
      \uC77C\uC73C\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998411
    m_Localized: "\uBAA8\uB4E0 \uACF5\uACA9\uC5D0 \uCD94\uAC00 \uD0C0\uC218\uB97C
      \uBD80\uC5EC\uD558\uB294 \uBC84\uD504\uB97C \uAC74\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998412
    m_Localized: "\uACF5\uACA9\uD558\uB294 \uB300\uC2E0 \uC5C4\uCCAD\uB09C \uD0C0\uC218
      \uBC84\uD504\uB97C \uAC74\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998413
    m_Localized: "\uB418\uAC10\uAE30 \uD6C4 \uB2E4\uC74C \uACF5\uACA9\uC774 \uAC15\uD654\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998414
    m_Localized: "\uB418\uAC10\uAE30 \uD6C4 \uC0AC\uC6A9\uD558\uB294 \uACF5\uACA9\uC758
      \uCFE8\uD0C0\uC784\uC774 2\uBC30\uAC00 \uB418\uC9C0\uB9CC, \uB05D\uC7A5\uB098\uAC8C
      \uAC15\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998415
    m_Localized: "\uACF5\uACA9 \uBC94\uC704\uAC00 \uB354\uC6B1 \uC99D\uAC00\uD558\uACE0,
      \uC801\uB4E4\uC5D0\uAC8C\uC11C \uCCB4\uB825\uC744 \uD761\uC218\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998416
    m_Localized: "\uACF5\uACA9\uB2F9\uD55C \uC801\uB4E4\uC774 \uAE34 \uC2DC\uAC04
      \uB3D9\uC548 \uAE30\uC808\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998417
    m_Localized: "\uC548\uAC1C\uAC00 \uB354 \uB113\uAC8C \uAE54\uB9AC\uACE0, \uB3C5\uC131\uC774
      \uB354\uC6B1 \uAC15\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998418
    m_Localized: "\uC911\uB3C5\uB41C \uCC44 \uC4F0\uB7EC\uC9C4 \uC801\uC740 \uC8FC\uBCC0
      \uC801\uC5D0\uAC8C \uB3C5\uC744 \uC62E\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998419
    m_Localized: "\uCE58\uBA85\uD0C0 \uD53C\uD574\uAC00 \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998420
    m_Localized: "\uCCB4\uB825\uC774 \uB354\uC6B1 \uBE60\uB974\uAC8C \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998421
    m_Localized: "\uC77C\uC815 \uD655\uB960\uB85C \uBE14\uB8E8\uBCA0\uB9AC\uAC00
      \uBCF4\uBB3C\uC0C1\uC790 \uBE14\uB8E8\uBCA0\uB9AC\uB85C \uBCC0\uD654\uD574
      \uB4F1\uC7A5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998422
    m_Localized: "\uCE58\uBA85\uD0C0\uB85C \uC8FD\uC740 \uC801\uC740 \uCD94\uAC00
      \uACBD\uD5D8\uCE58\uB97C \uB0A8\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998423
    m_Localized: "\uD53C\uD574\uB97C \uC785\uC744 \uB54C\uB9C8\uB2E4 \uD718\uB450\uB974\uAE30\uAC00
      \uBC1C\uB3D9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649661712998424
    m_Localized: "\uC2A4\uD0AC \uC0AC\uC6A9 \uC2DC \uB0AE\uC740 \uD655\uB960\uB85C
      \uCFE8\uD0C0\uC784\uC774 \uCD08\uAE30\uD654\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9649662912569344
    m_Localized: "\uD638\uBC0D \uBBF8\uC0AC\uC77C\uB85C \uCC98\uCE58 \uC2DC \uACBD\uD5D8\uCE58
      {0}\uBC30"
    m_Metadata:
      m_Items: []
  - m_Id: 9649662912569345
    m_Localized: "\uCE58\uBA85\uD0C0 \uD655\uB960 \uC0C1\uD55C {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 9649662912569346
    m_Localized: "[\uC7A0\uAE40 \u2014 '{0}' \uC9C4\uD654 \uD544\uC694]"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
